# Adresse du backend Spring Boot (sans / final)
# En local : http://localhost:8080
# En ligne : l'URL donnee par Render, par exemple https://edustream-backend.onrender.com
BACKEND_URL=http://localhost:8080

# Mot de passe de l'espace administrateur (a definir aussi cote backend)
ADMIN_PASSWORD=mysuperdupercoopersecret

# --- Canary + Unleash (optionnel) ---
# Sans BACKEND_CANARY_URL, tout le trafic va vers BACKEND_URL.
# BACKEND_CANARY_URL=https://edustream-canary.up.railway.app
# UNLEASH_URL=https://<votre-serveur-unleash>/api
# UNLEASH_API_TOKEN=<jeton Backend de l'environnement production>
